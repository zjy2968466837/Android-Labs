<?xml version="1.0" encoding="utf-8"?>
<!-- 牌背（未翻开）：深紫渐变 + 浅紫细边 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/card_back_end"
        android:startColor="@color/card_back_start" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_back_stroke" />
</shape>
