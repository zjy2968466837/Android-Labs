# ── Gradle ────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ── 机器相关配置（不同电脑路径不同，不入库；IDE 会自动生成）──
local.properties

# ── Android Studio / IntelliJ 工程配置 ────────────────────
# 不入库：换机器后由 Android Studio 打开工程时自动重新生成，
# 且其中可能残留本机的绝对路径，反而影响别人拉取后使用。
.idea/
*.iml

# ── 构建产物 ──────────────────────────────────────────────
/captures
.externalNativeBuild
.cxx

# ── 实验报告等文档（作为附件单独提交，不进代码仓库）───────
*.docx
*.doc

# ── 各实验的报告配图与运行/代码截图（本地留存供写报告用）──
# 与能否编译运行无关，故不入仓库
Lab*/docs/

# ── 工具产生的本地状态，与作业内容无关 ────────────────────
.codebuddy/

# ── 国旗素材的解压残留（真正用到的资源在 Lab1/app/src/main/res/ 下）──
国旗/

# ── 临时：Lab1 改名后留下的空目录，Android Studio 会按旧路径重新生成 ──
# 确认删除该目录后，本行可以一并删掉
/demo/

# ── 签名文件（切勿提交）───────────────────────────────────
*.jks
*.keystore

# ── 操作系统 ──────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 临时 / 备份文件 ───────────────────────────────────────
*.bak
*.orig
*.rej
